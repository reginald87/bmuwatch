{
  "name": "bmu-watch",
  "version": "0.1.0",
  "private": true,
  "description": "BMU WATCH - See it. Report it. Keep BMU Safe. Offline-first campus security reporting PWA.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "artifact": "node scripts/make-artifact.mjs",
    "start": "next start",
    "start:cpanel": "node server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:prod": "tsx prisma/seed.prod.ts",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^18.0.8",
    "jose": "^5.9.6",
    "next": "15.5.24",
    "prisma": "6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
