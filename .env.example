# Copy this file to .env and adjust values.

# SQLite database file location (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Secrets - MUST change in production. Use at least 32 random characters.
# AUTH_SECRET is required; JWT_SECRET is accepted as a fallback.
AUTH_SECRET="change-me"
# JWT_SECRET="change-me"

# Base URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Where uploaded attachments are stored on disk. Optional; defaults to ./uploads
# under the project root. Must end with a path separator (-sep) if provided.
# UPLOAD_DIR="C:/data/bmuwatch/uploads/"

# Seed admin credentials - DEV ONLY
SEED_SUPER_ADMIN_EMAIL="superadmin@bmuwatch.dev"
SEED_SUPER_ADMIN_PASSWORD="SuperAdmin!12345"
SEED_CSO_EMAIL="cso@bmuwatch.dev"
SEED_CSO_PASSWORD="CsoAdmin!12345"
SEED_OFFICER_EMAIL="officer@bmuwatch.dev"
SEED_OFFICER_PASSWORD="Officer!12345"
